# Copie para .env e ajuste para a sua máquina (o .env não vai para o git).

# Pasta "Surfzada MKT" do Google Drive, montada pelo Drive para computador.
# Windows: G:/Drives compartilhados/Surfzada MKT  ·  macOS: ~/Library/CloudStorage/GoogleDrive-<email>/Drives compartilhados/Surfzada MKT
MKT_DRIVE=

# Pasta temporária do render (o Remotion deixa sobras grandes). Use um disco com espaço.
# Vazio = pasta temporária padrão do sistema.
MKT_TEMP=

# API usada pelos scripts de dados (previsão) e pela captura de telas.
API_URL=https://api.surfzada.com.br/api
